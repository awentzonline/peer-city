{
  "name": "p2p-game-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Peer-to-peer open-world multiplayer framework for Phaser 4 + Trystero, with a GTA-style demo game",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx scripts/loadsim.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "trystero": "0.25.4"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
